{
  "name": "paseo-scripted-provider",
  "version": "0.1.1",
  "description": "Paseo plugin: a scripted (model-free) agent provider with session-to-script recording.",
  "license": "MIT",
  "author": "quickwind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quickwind/paseo-scripted-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "paseo-plugin.json",
    "index.server.ts",
    "index.client.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "e2e": "node --test --test-timeout=300000 \"e2e/*.test.mjs\"",
    "e2e:npm": "node --test --test-timeout=300000 e2e/npm-install.e2e.mjs",
    "verify:package": "node scripts/verify-package.mjs && node scripts/verify-package.mjs testkit",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:hermes": "node scripts/check-hermes-client-bundle.mjs",
    "vendor:yaml": "node scripts/vendor-yaml.mjs",
    "verify:real": "vitest run --config vitest.real.config.ts"
  },
  "devDependencies": {
    "@getpaseo/client": ">=0.11.2",
    "@getpaseo/plugin": ">=0.11.2",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "esbuild": "0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yaml": "2.9.1",
    "zod": "^4.4.3"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "testing",
    "mock",
    "scripted",
    "e2e"
  ]
}
